# Token bersama antara n8n dan render service.
# Generate: openssl rand -hex 24
SERVICE_TOKEN=ganti-dengan-token-acak-minimal-16-karakter

# URL publik service ini (dipakai untuk menyusun URL part audio yang dikirim ke n8n).
PUBLIC_BASE_URL=https://notulensi-render.contoh.com

PORT=3000

# --- Render mind map ---
RENDER_WIDTH=1600
RENDER_SCALE=2
RENDER_MIN_HEIGHT=500
RENDER_MAX_HEIGHT=4000
RENDER_TIMEOUT_MS=45000

# --- Penyiapan audio ---
# 24MB — di bawah batas 25MB Whisper API (Groq & OpenAI).
MAX_PART_BYTES=25165824
MAX_UPLOAD_BYTES=536870912
OPUS_BITRATE_KBPS=16
AUDIO_TTL_MS=1800000
AUDIO_WORK_DIR=/data/audio
