{
  "name": "notulensi-render-service",
  "version": "1.0.0",
  "private": true,
  "description": "Micro-service render mind map (markmap + Puppeteer) dan penyiapan audio (ffmpeg) untuk pipeline Voice-to-Mindmap n8n",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "express": "^4.21.2",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "multer": "^2.0.0",
    "puppeteer": "^24.0.0"
  }
}
